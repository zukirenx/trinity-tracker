# Copy to .env for local scripts (never commit .env).
# Production values live as Cloudflare Worker secrets
# (npx wrangler secret put NAME), not in this file.

# --- Discord app (Developer Portal -> General Information / Bot) ---
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# --- Discord server/channels (right-click -> Copy Channel/Server ID, Developer Mode on) ---
TRACKING_CHANNEL_ID=
ROSTER_CHANNEL_ID=
LEADERBOARD_CHANNEL_ID=
GUILD_ID=

# --- Web dashboard (optional but recommended) ---
# Base URL of the deployed Worker, e.g. https://lw-discord-bot.<your-subdomain>.workers.dev
WEB_URL=
# Workers.dev subdomain used by scripts/web-link.ts to construct the URL
CF_WORKERS_SUBDOMAIN=

# --- Local overrides ---
# Optional: override Discord API base URL (tests / debugging only)
DISCORD_API_BASE=https://discord.com/api/v10
